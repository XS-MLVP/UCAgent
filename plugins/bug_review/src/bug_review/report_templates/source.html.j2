{# Markdown reading view with the exact original source-line coordinate system. #}
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ name }}</title><link rel="stylesheet" href="standard-reader.css"></head><body data-line-prefix="{{ labels.source_line_prefix }}" data-line-suffix="{{ labels.source_line_suffix }}"><header class="reader-header"><div><a href="../index.html">← {{ labels.back_to_report }}</a><h1>{{ name }}</h1></div>{% if markdown %}<div class="reader-controls"><button id="read-view" class="active">{{ labels.read_view }}</button><button id="raw-view">{{ labels.raw_view }}</button><span id="source-position"></span></div>{% endif %}</header><div class="reader-grid">{% if toc %}<nav class="reader-toc"><strong>{{ labels.document_toc }}</strong>{% for heading in toc %}<a class="{{ 'sub' if heading.level > 2 else '' }}" href="#L{{ heading.line }}">{{ heading.text }}</a>{% endfor %}</nav>{% else %}<nav class="reader-toc"><strong>{{ labels.source_doc }}</strong></nav>{% endif %}<main class="reader-content">{% if provenance %}<div class="reader-meta">{% if provenance.url %}<a href="{{ provenance.url }}" target="_blank" rel="noopener">{{ labels.upstream_source }} ↗</a><br>{% endif %}{{ labels.source_revision }}: {{ provenance.revision }}<br>{{ labels.retrieved_at }}: {{ provenance.retrieved_at }}</div>{% endif %}{% if markdown %}<article class="md-body" id="markdown-content">{{ rendered }}<div class="line-targets">{% for line in missing_lines %}<span id="L{{ line }}"></span>{% endfor %}</div></article>{% endif %}<pre class="raw-body" id="raw-content" {% if markdown %}hidden{% endif %}>{% for line in lines %}<span class="raw-line" id="{{ 'raw-' if markdown else '' }}L{{ loop.index }}">{{ loop.index }}  {{ line }}</span>
{% endfor %}</pre><p class="reader-note">{{ labels.reader_note if markdown else labels.source_doc }}</p></main></div>{% if markdown %}<script src="standard-reader.js"></script>{% endif %}</body></html>
