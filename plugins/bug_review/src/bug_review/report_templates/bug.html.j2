{# One Bug narrative on the left and linked actual evidence on the right. #}
{% extends 'base.html.j2' %}{% block content %}
<div class="hero detail-hero"><div><div class="eyebrow">{{ bug.claim.claim_id }}</div><h1>{{ bug.decision.narrative.title }}</h1><p class="detail-summary">{{ bug.decision.narrative.summary }}</p><div class="detail-meta">{{ badge(labels['review_'+bug.decision.verdict],bug.color) }}<span>{{ bug.cases|length }} {{ labels.case_count }}</span>{{ badge(labels.not_fixed) }}</div></div></div>
<div class="detail-grid"><div class="analysis-column"><div class="column-heading">{{ labels.analysis }}</div>
<section class="panel analysis-section"><div class="section-label">01 / EXPECTED BEHAVIOR</div><h2>{{ labels.expected_behavior }}</h2><p>{{ bug.decision.narrative.expected_behavior }}</p></section>
<section class="panel analysis-section"><div class="section-label">02 / REPRODUCTION</div><h2>{{ labels.reproduction }}</h2><ol class="steps">{% for step in bug.decision.narrative.trigger_steps %}<li>{{ step }}</li>{% endfor %}</ol><div class="comparison"><table><thead><tr><th>{{ labels.observation }}</th><th>{{ labels.expected }}</th><th>{{ labels.actual }}</th></tr></thead><tbody>{% for row in bug.decision.narrative.comparisons %}<tr><td>{{ row.condition }}</td><td class="good">{{ row.expected }}</td><td class="bad">{{ row.actual }}{% for source in row_sources[loop.index0] %}<br><a class="tiny" href="{{ source.href }}">{{ source.label }} ↗</a>{% endfor %}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="panel analysis-section"><div class="section-label">03 / CAUSAL ANALYSIS</div><h2>{{ labels.causal_analysis }}</h2><p>{{ bug.decision.narrative.cause_analysis }}</p><div class="callout {{ bug.color }}">{{ bug.decision.reasoning }}</div>{% if bug.decision.root_id %}<a href="{{ bug.decision.root_id }}.html">{{ labels.root_details }} · {{ bug.decision.root_id }} ↗</a>{% endif %}</section>
<section class="panel analysis-section"><div class="section-label">04 / IMPACT & NEXT STEP</div><h2>{{ labels.impact_next }}</h2><ul class="consequence">{% for effect in bug.decision.narrative.impact %}<li>{{ effect }}</li>{% endfor %}</ul><p>{{ bug.decision.next_action }}</p>{% if bug.decision.remaining_gap %}<div class="callout amber">{{ bug.decision.remaining_gap }}</div>{% endif %}<details><summary>{{ labels.scope_limits }}</summary><p>{{ bug.decision.narrative.scope }}</p></details></section>
<section class="panel analysis-section"><details><summary>{{ labels.original_statement }}</summary><p>{{ bug.claim.statement }}</p>{% if bug.claim.missing_information %}<p>{{ bug.claim.missing_information }}</p>{% endif %}</details></section><nav class="detail-pager"><a href="index.html#{{ bug.claim.claim_id }}">← {{ labels.back_to_bugs }}</a><a href="index.html#cases">{{ labels.failed_cases }} →</a></nav></div>{% include 'evidence.html.j2' %}</div>
{% endblock %}
