{# Module-level claims and failure classifications, derived from the one record. #}
{% extends 'base.html.j2' %}{% block content %}
<div class="hero"><div><div class="eyebrow">{{ labels.module_review }}</div><h1>{{ review.module }}</h1><p>{{ review.context.description }}</p></div><div class="hero-badges">{{ badge(labels.local_review,'blue') }}{{ badge(labels.not_fixed) }}</div></div>
<section class="stats"><div class="stat"><div class="label">{{ labels.claims }}</div><div class="value">{{ review.claims|length }}</div><div class="hint">{{ labels.deduplicated }}</div></div><div class="stat red"><div class="label">{{ labels.confirmed }}</div><div class="value">{{ counts.confirmed }}</div></div><div class="stat amber"><div class="label">{{ labels.inconclusive }}</div><div class="value">{{ counts.inconclusive }}</div></div><div class="stat"><div class="label">{{ labels.failed_case_count }}</div><div class="value">{{ failed_cases|length }}</div></div></section>
<section class="panel" id="bugs"><div class="panel-head"><div><h2>{{ labels.bug_list }}<span class="count">{{ bugs|length }}</span></h2><div class="panel-sub">{{ labels.claim_count_note }}</div></div><input id="report-search" class="search" type="search" placeholder="{{ labels.search }}" aria-label="{{ labels.search }}"></div><div class="table-wrap"><table id="bug-table"><thead><tr><th>{{ labels.problem }}</th><th>{{ labels.verdict }}</th><th>{{ labels.related_failures }}</th><th></th></tr></thead><tbody>{% for item in bugs %}<tr id="{{ item.claim.claim_id }}" data-search="{{ item.search }}"><td style="width:57%"><span class="bug-id">{{ item.claim.claim_id }}</span><a class="bug-title" href="{{ item.href }}">{{ item.decision.narrative.title }}</a><div class="bug-description">{{ item.decision.narrative.summary }}</div></td><td>{{ badge(labels['review_'+item.decision.verdict], item.color) }}</td><td><span class="mono">{{ item.cases|length }}</span> <span class="muted tiny">{{ labels.case_count }}</span></td><td><a class="arrow-link" href="{{ item.href }}" aria-label="{{ item.claim.claim_id }}">↗</a></td></tr>{% endfor %}</tbody></table></div><div class="empty" id="bug-empty" {% if bugs %}hidden{% endif %}>{{ labels.empty_bugs }}</div></section>
<section class="panel" id="cases"><div class="panel-head"><div><h2>{{ labels.failed_cases }}<span class="count" id="case-count">{{ failed_cases|length }} / {{ failed_cases|length }}</span></h2><div class="panel-sub">{{ labels.case_table_note }}</div></div><div class="panel-tools"><select id="case-filter" aria-label="{{ labels.failure_category }}"><option value="all">{{ labels.all_categories }} · {{ failed_cases|length }}</option>{% for category,count in categories.items() %}<option value="{{ category }}">{{ labels['category_'+category] }} · {{ count }}</option>{% endfor %}</select></div></div><div class="table-wrap"><table id="case-table"><thead><tr><th style="width:38%">{{ labels.case_node }}</th><th style="width:18%">{{ labels.failure_category }}</th><th>{{ labels.failure_phenomenon }}</th><th>{{ labels.related_bug }}</th></tr></thead><tbody>{% for item in failed_cases %}<tr data-category="{{ item.case.analysis.category }}" data-search="{{ item.search }}"><td><span class="bug-id">{{ item.case.case_key }}</span><a class="node node-name" href="{{ item.href }}">{{ item.function }}</a><div class="node-file">{{ item.test_file }}</div>{% if item.waves %}<a class="tiny" href="{{ item.waves[0].href }}" target="_blank" rel="noopener">{{ labels.raw_waveforms }} ↗</a>{% endif %}</td><td>{{ badge(labels['category_'+item.case.analysis.category],item.color) }}</td><td class="failure-label">{{ item.case.analysis.actual }}</td><td>{% for id in item.claim_ids %}<a class="mono tiny" href="{{ id }}.html">{{ id }} ↗</a><br>{% endfor %}</td></tr>{% endfor %}</tbody></table></div><div class="empty" id="case-empty" {% if failed_cases %}hidden{% endif %}>{{ labels.empty_cases }}</div><div class="summary-data"><span>{{ labels.selected_execution }} <strong>{{ counts.selected_runs }}</strong></span><span>{{ labels.result }} <strong>{{ counts.passed }} passed / {{ failed_cases|length }} failed</strong></span></div></section>
<div class="support-grid"><section class="panel support"><h3>{{ labels.failure_categories }}</h3><dl class="legend">{% for category in ['dut','test','environment','specification','unresolved'] %}<dt>{{ labels['category_'+category] }}</dt><dd>{{ labels['legend_'+category] }}</dd>{% endfor %}</dl></section><section class="panel support"><h3>{{ labels.other_runs }}</h3><p>{{ labels.environment_separate }}</p>{% for issue in issues %}<details><summary><span class="mono">{{ issue.record.invocation_id }}</span> · {{ issue.record.diagnostic }}</summary><p>{% for source in issue.sources %}<a href="{{ source.href }}">{{ source.label }} ↗</a><br>{% endfor %}</p></details>{% endfor %}<details><summary>{{ labels.source_accounting }}</summary><p>{% for source in review.source_reviews %}{{ source.path }} · {{ source.disposition }} · {{ source.reason }}<br>{% endfor %}</p></details><p><a href="{{ catalog.href }}">{{ labels.standard_versions }} ↗</a></p></section></div>
<div class="scope-note"><strong>{{ labels.applicability }}</strong> {{ review.context.scope }}{% if review.context.version %}<br><strong>{{ labels.version }}</strong> {{ review.context.version }}{% endif %}{% if review.context.configuration %}<br><strong>{{ labels.configuration }}</strong> {{ review.context.configuration }}{% endif %}{% for limitation in review.context.limitations %}<br>{{ limitation }}{% endfor %}{% for gap in review.input_gaps %}<br>{{ gap }}{% endfor %}</div>
{% endblock %}{% block scripts %}<script src="assets/report.js"></script>{% endblock %}
