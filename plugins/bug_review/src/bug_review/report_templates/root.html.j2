{# Shared root causes remain single definitions across Bug pages. #}
{% extends 'base.html.j2' %}{% block content %}<div class="hero"><div><div class="eyebrow">{{ root.root_id }}</div><h1>{{ root.title }}</h1><p>{{ labels[root.basis] }}</p></div></div><section class="panel analysis-section"><p>{{ root.explanation }}</p><h2>{{ labels.review_alternatives }}</h2><p>{{ root.alternatives }}</p>{% for source in root_sources %}<a href="{{ source.href }}">{{ source.label }} ↗</a><pre class="snippet code">{{ source.excerpt }}</pre>{% endfor %}<h2>{{ labels.related_claims }}</h2>{% for bug in bugs %}{% if bug.decision.root_id==root.root_id %}<p><a href="{{ bug.href }}">{{ bug.claim.claim_id }} · {{ bug.decision.narrative.title }} ↗</a></p>{% endif %}{% endfor %}</section>{% endblock %}
