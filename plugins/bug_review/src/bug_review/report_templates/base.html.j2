{# Shared report shell; all visible task text comes from locale resources. #}
{% macro badge(text, kind='neutral') -%}<span class="badge {{ kind }}"><span class="status-dot"></span>{{ text }}</span>{%- endmacro %}
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ title }} · {{ review.module }}</title><link rel="stylesheet" href="assets/review.css"></head><body>
<aside class="sidebar"><a class="brand" href="index.html"><span class="brand-logo">UC</span>{{ labels.brand }}</a><div class="nav-caption">{{ labels.current_module }}</div><a class="nav-link {{ 'active' if active == 'module' else '' }}" href="index.html"><span>{{ review.module }}</span><span class="num">{{ review.claims|length }}</span></a><a class="nav-link" href="index.html#cases"><span>{{ labels.failed_cases }}</span><span class="num">{{ failed_cases|length }}</span></a><div class="nav-caption">{{ labels.bug_details }}</div>{% for item in bugs %}<a class="nav-link nav-bug {{ 'active' if active == item.claim.claim_id else '' }}" href="{{ item.href }}"><span>{{ item.claim.claim_id }}<small>{{ item.decision.narrative.title }}</small></span><span class="num">{{ item.cases|length }}</span></a>{% endfor %}<div class="side-footer"><strong>{{ labels.local_review }}</strong>{{ labels.updated_from_record }}</div></aside>
<div class="workspace"><header class="topbar"><nav class="breadcrumb"><a href="{{ portal_href }}">{{ labels.brand }}</a><span>/</span><a href="index.html">{{ review.module }}</a><span>/</span><strong>{{ breadcrumb }}</strong></nav><div class="top-meta"><span><i class="dot"></i>{{ labels.updated_from_record }}</span></div></header><main class="page">{% block content %}{% endblock %}<footer class="footer"><span>{{ review.module }} · {{ labels.brand }}</span><span>{{ labels.read_only_generated }}</span></footer></main></div>{% block scripts %}{% endblock %}</body></html>
