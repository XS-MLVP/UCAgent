{# Case-level classified failure and exact execution provenance. #}
{% extends 'base.html.j2' %}{% block content %}<div class="hero detail-hero case-hero"><div><div class="eyebrow">{{ item.case.case_key }}</div><h1 class="mono">{{ item.function }}</h1><p class="mono tiny">{{ item.test_file }}</p><div class="detail-meta">{{ badge(labels['category_'+item.case.analysis.category],item.color) }}{% if item.selected %}{{ badge(item.selected.status) }}{% endif %}{% for id in item.claim_ids %}<a href="{{ id }}.html">{{ labels.related_bug }} {{ id }} ↗</a>{% endfor %}{% if test_source %}<a href="{{ test_source.href }}">{{ labels.open_test }} ↗</a>{% endif %}</div></div></div><div class="detail-grid"><div class="analysis-column"><div class="column-heading">{{ labels.case_analysis }}</div>{% for field in ['scenario','specification_expected','test_expected','actual','test_validity','timing_review','reasoning','remaining_gap','next_action','replay_blocker'] %}{% if item.case.analysis[field] %}<section class="panel analysis-section"><h2>{{ labels['review_'+field] }}</h2><p>{{ item.case.analysis[field] }}</p></section>{% endif %}{% endfor %}{% if item.case.waveform_note %}<section class="panel analysis-section"><p>{{ item.case.waveform_note }}</p></section>{% endif %}</div>{% include 'evidence.html.j2' %}</div>{% endblock %}
