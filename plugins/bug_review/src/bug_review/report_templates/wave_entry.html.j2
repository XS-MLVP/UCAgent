{# Static, portable waveform routing; no fixed machine hostname or server port. #}
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ labels.opening_surfer }}</title><link rel="stylesheet" href="review.css"></head><body><main class="page" style="max-width:800px;margin:auto"><h1>{{ labels.opening_surfer }}</h1><p id="wave-status">{{ labels.raw_wave_note }}</p><p><a href="../index.html#cases">← {{ labels.back_to_report }}</a></p><div class="wave-links">{% for wave in waves %}<a class="wave-link" href="surfer/index.html?{{ wave.query }}" data-wave-id="{{ wave.id }}"><span>{{ wave.label }}</span><span>↗</span></a>{% endfor %}</div><p class="scope-note" id="http-required" hidden>{{ labels.start_local_server }}</p></main><script src="wave-entry.js"></script></body></html>
