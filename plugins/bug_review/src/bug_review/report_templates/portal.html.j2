{# Published modules use manifests derived from their canonical review tables. #}
<!doctype html><html lang="zh-CN"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ labels.brand }}</title><style>body{font:15px/1.8 system-ui;max-width:1100px;margin:48px auto;padding:0 24px;color:#273b57;background:#f5f7fb}table{width:100%;border-collapse:collapse;background:white}td,th{padding:16px;text-align:left;border-bottom:1px solid #e1e8f2}a{color:#365ce6;text-decoration:none}</style><h1>{{ labels.brand }}</h1><table><thead><tr><th>{{ labels.current_module }}</th><th>{{ labels.claims }}</th><th>{{ labels.confirmed }}</th><th>{{ labels.inconclusive }}</th></tr></thead><tbody>{% for item in modules %}<tr><td><a href="{{ item.href }}">{{ item.module }}</a></td><td>{{ item.claims }}</td><td>{{ item.confirmed }}</td><td>{{ item.unresolved }}</td></tr>{% endfor %}</tbody></table></html>
