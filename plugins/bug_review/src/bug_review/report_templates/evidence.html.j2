{# Evidence is a read-only projection of tool facts and validated source references. #}
<aside class="evidence-column"><div class="column-heading">{{ labels.evidence }}</div>
{% if evidence.waves %}<section class="panel evidence-card"><div class="evidence-title"><h3>{{ labels.raw_waveforms }}</h3></div><div class="wave-links">{% for wave in evidence.waves %}<a class="wave-link" href="{{ wave.href }}" target="_blank" rel="noopener"><span>{{ wave.label }}<small>{{ labels.analyzed_preview if wave.analyzed else labels.raw_preview }}</small></span><span class="arrow">↗</span></a><a class="evidence-link" href="{{ wave.download_href }}" download>{{ labels.download_waveform }} ↗</a>{% if wave.observation %}<p>{{ wave.observation }}</p>{% endif %}{% endfor %}</div><p>{{ labels.raw_wave_note }}</p></section>{% endif %}
<section class="panel evidence-card"><div class="evidence-title"><h3><span class="evidence-num">01</span>{{ labels.real_execution }}</h3></div>{% for execution in evidence.executions %}<dl class="kv"><dt>{{ labels.execution_id }}</dt><dd class="mono">{{ execution.invocation_id }}</dd><dt>{{ labels.evidence_kind }}</dt><dd>{{ labels[execution.provenance] }}</dd><dt>{{ labels.result }}</dt><dd>{{ execution.status }}</dd></dl>{% endfor %}{% for source in evidence.failures %}<pre class="snippet">{{ source.excerpt }}</pre><a class="evidence-link" href="{{ source.href }}">{{ source.label }} ↗</a>{% endfor %}{% for source in evidence.execution_sources %}<p><a class="evidence-link" href="{{ source.href }}">{{ source.label }} ↗</a></p>{% endfor %}</section>
{% for title,sources in [(labels.standard_clauses,evidence.standards),(labels.current_rtl,evidence.rtl),(labels.source_links,evidence.sources)] %}{% if sources %}<section class="panel evidence-card"><div class="evidence-title"><h3>{{ title }}</h3></div><ul class="clauses">{% for source in sources %}<li><a href="{{ source.href }}">{{ source.label }} ↗</a>{% if title==labels.current_rtl %}<pre class="snippet code">{{ source.excerpt }}</pre>{% endif %}</li>{% endfor %}</ul>{% if title==labels.current_rtl %}<p>{{ labels.no_wave_claim }}</p>{% endif %}</section>{% endif %}{% endfor %}
{% if evidence.events %}<section class="panel evidence-card"><h3>{{ labels.waveform_events }}</h3>{% for event in evidence.events %}<pre class="snippet">{{ event.signal_path }} @ {{ event.time }}: {{ event.raw_value }}
{{ event.description }}
{{ event.expected }}</pre>{% endfor %}</section>{% endif %}
{% if evidence.cases %}<section class="panel evidence-card"><div class="evidence-title"><h3>{{ labels.associated_cases }}</h3></div><div class="case-chips">{% for item in evidence.cases %}<a class="case-chip" href="{{ item.href }}"><span class="node">{{ item.function }}</span><small>{{ item.case.case_key }} · {{ labels['category_'+item.case.analysis.category] }}{% if item.selected %} · {{ item.selected.status }}{% endif %}</small></a>{% endfor %}</div></section>{% endif %}
{% if evidence.originals %}<section class="panel evidence-card"><div class="evidence-title"><h3>{{ labels.original_sources }}</h3></div>{% for source in evidence.originals %}<a class="evidence-link" href="{{ source.href }}">{{ source.label }} ↗</a><br>{% endfor %}<p>{{ labels.original_not_proof }}</p></section>{% endif %}
</aside>
