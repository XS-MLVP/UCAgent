  "targets": [
    {
      "target_id": "FC-SDC-REG-ACCESS",
      "name": "Wishbone slave register read and write",
      "weight": 1,
      "coverage_definition": "Access internal configuration and status registers through WB slave port",
      "sampling_rule": "Drive WB slave read/write cycles to register address map",
      "oracle_definition": "Written control registers retain data; read-only registers reflect hardware status",
      "collection_status": "scoreable"
    },
    {
      "target_id": "FC-SDC-RESET-CLEAR",
      "name": "controller reset and register clearance",
      "weight": 1,
      "coverage_definition": "Perform hardware/software reset to restore all submodules to initial state",
      "sampling_rule": "Sample control registers, FIFOs, and FSM states after reset pulse",
      "oracle_definition": "Registers clear to default reset values and internal queues empty",
      "collection_status": "scoreable"
    },
    {
      "target_id": "FC-SDC-BD-MANAGEMENT",
      "name": "Buffer Descriptor (BD) allocation and chaining",
      "weight": 1,
      "coverage_definition": "Configure, allocate, and link 16-bit/32-bit Buffer Descriptors for DMA",
      "sampling_rule": "Sample BD RAM/register entries and ownership bits during setup",
      "oracle_definition": "BD fields accurately represent transfer length, buffer pointer, and interrupt enable",
      "collection_status": "scoreable"
    },
    {
      "target_id": "FC-SDC-DMA-TRANSFER",
      "name": "internal DMA master bus transfer activity",
      "weight": 1,
      "coverage_definition": "Initiate DMA data transfers between external memory and SDC FIFO",
      "sampling_rule": "Sample DMA master bus requests, address generation, and data transfers",
      "oracle_definition": "DMA moves specified byte count autonomously without bus error",
      "collection_status": "scoreable"
    },
    {
      "target_id": "FC-SDC-INTERRUPT-CONTROL",
      "name": "interrupt generation and mask control",
      "weight": 1,
      "coverage_definition": "Verify interrupt generation on transfer complete/error and test mask register",
      "sampling_rule": "Sample interrupt request line with interrupt mask enabled and disabled",
      "oracle_definition": "IRQ line asserts only when unmasked event occurs and clears on status acknowledge",
      "collection_status": "scoreable"
    },
    {
      "target_id": "FC-SDC-SD-IO-HANDSHAKE",
      "name": "card-side SD/MMC physical bus interface",
      "weight": 1,
      "coverage_definition": "Drive and sample clock, command, and data lines to the SD/MMC card",
      "sampling_rule": "Sample sd_cmd and sd_dat bus bidirectional pins during transactions",
      "oracle_definition": "IO lines adhere to SD bus protocol timing specifications",
      "collection_status": "scoreable"
    }
  ],
