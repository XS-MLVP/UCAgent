      "collection_status": "scoreable"
    },
    {
      "target_id": "FC-DTCM-CTRL-LSU-READ",
      "name": "LSU ICB read transaction",
      "weight": 1,
      "coverage_definition": "Perform read access initiated by processor Load-Store Unit",
      "sampling_rule": "Sample LSU cmd/rsp handshakes and SRAM read interface signals",
      "oracle_definition": "Requested address is sent to SRAM and read data returned on rsp channel",
      "collection_status": "scoreable"
    },
    {
      "target_id": "FC-DTCM-CTRL-LSU-WRITE",
      "name": "LSU ICB write transaction",
      "weight": 1,
      "coverage_definition": "Perform write access with byte write masks initiated by LSU",
      "sampling_rule": "Sample LSU write data, write mask, and SRAM write enable signals",
      "oracle_definition": "Write data and mask correctly propagate to SRAM with single-cycle response",
      "collection_status": "scoreable"
    },
    {
      "target_id": "FC-DTCM-CTRL-EXT-ACCESS",
      "name": "external ICB port access",
      "weight": 1,
      "coverage_definition": "Perform read and write transactions through the external slave ICB interface",
      "sampling_rule": "Sample external interface request and response channels",
      "oracle_definition": "External access executes cleanly without corrupting internal CPU state",
      "collection_status": "scoreable"
    },
    {
      "target_id": "FC-DTCM-CTRL-ACTIVE-POWER",
      "name": "DTCM active and low-power control",
      "weight": 1,
      "coverage_definition": "Monitor dtcm_active signal assertion on access and deassertion on idle",
      "sampling_rule": "Sample dtcm_active before, during, and after memory transactions",
      "oracle_definition": "dtcm_active is high when transactions are pending/active and low when idle",
      "collection_status": "scoreable"
    },
    {
      "target_id": "FC-DTCM-CTRL-ADDR-DECODE",
      "name": "DTCM address boundary decoding",
      "weight": 1,
      "coverage_definition": "Exercise access at min, max, and boundary offsets of the DTCM address space",
      "sampling_rule": "Sample generated SRAM address lines across boundary requests",
      "oracle_definition": "Address offsets correctly map to physical SRAM word addresses",
      "collection_status": "scoreable"
    }
