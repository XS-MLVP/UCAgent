      "name": "RAM array initialization and reset",
      "weight": 1,
      "coverage_definition": "Verify RAM behavior after reset and initialization",
      "sampling_rule": "Sample uninitialized read outputs and reset state transitions",
      "oracle_definition": "Reset does not cause undefined state or bus contention",
      "collection_status": "scoreable"
    },
    {
      "target_id": "FC-DTCM-RAM-SINGLE-READ",
      "name": "synchronous single-cycle read",
      "weight": 1,
      "coverage_definition": "Read data from initialized memory addresses across sequential cycles",
      "sampling_rule": "Assert cs and read address; sample dout on next clock edge",
      "oracle_definition": "dout matches previously written content at target address",
      "collection_status": "scoreable"
    },
    {
      "target_id": "FC-DTCM-RAM-SINGLE-WRITE",
      "name": "synchronous single-cycle write",
      "weight": 1,
      "coverage_definition": "Write 32-bit data into memory addresses with write enable asserted",
      "sampling_rule": "Assert cs, we, addr, and din; verify commit on clock edge",
      "oracle_definition": "Target memory location stores din correctly",
      "collection_status": "scoreable"
    },
    {
      "target_id": "FC-DTCM-RAM-RAW",
      "name": "read-after-write hazard verification",
      "weight": 1,
      "coverage_definition": "Perform consecutive write and read to the same memory address",
      "sampling_rule": "Write to address A in cycle N, read address A in cycle N+1",
      "oracle_definition": "Read returns the newly written value accurately",
      "collection_status": "scoreable"
    },
    {
      "target_id": "FC-DTCM-RAM-BOUNDARY-ADDR",
      "name": "address space boundary access",
      "weight": 1,
      "coverage_definition": "Access lowest (0x0) and highest address boundaries of the memory array",
      "sampling_rule": "Drive min and max valid addresses and sample read/write responses",
      "oracle_definition": "No aliasing or truncation occurs at address extremities",
      "collection_status": "scoreable"
    }
  ],
