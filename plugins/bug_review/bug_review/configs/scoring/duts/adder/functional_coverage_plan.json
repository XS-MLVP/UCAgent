      "target_id": "FC-ADDER-NORMAL",
      "name": "ordinary addition result",
      "weight": 1,
      "coverage_definition": "Observe at least one non-overflowing a+b+cin transaction and compare sum/cout with a 65-bit reference",
      "sampling_rule": "Sample inputs before evaluation and sample sum/cout after the combinational settle boundary",
      "oracle_definition": "{cout,sum} equals the low 65 bits of zero_extend(a)+zero_extend(b)+cin"
    },
    {
      "target_id": "FC-ADDER-CIN",
      "name": "carry-in control",
      "weight": 1,
      "coverage_definition": "Observe matched operand transactions with cin=0 and cin=1",
      "sampling_rule": "Sample the matched pair under the same settle rule",
      "oracle_definition": "The cin=1 result is exactly one greater in 65-bit arithmetic"
    },
    {
      "target_id": "FC-ADDER-CARRY-CHAIN",
      "name": "high-bit carry propagation",
      "weight": 1,
      "coverage_definition": "Exercise a transaction whose carry propagates through bit 63",
      "sampling_rule": "Sample sum and cout after the full combinational settle boundary",
      "oracle_definition": "sum and cout equal the 65-bit reference result"
    },
    {
      "target_id": "FC-ADDER-OVERFLOW",
      "name": "unsigned overflow and wrap",
      "weight": 1,
      "coverage_definition": "Exercise at least one transaction with a 65-bit result greater than 2^64-1",
      "sampling_rule": "Sample sum and cout together for the overflowing transaction",
      "oracle_definition": "cout is one and sum equals the result modulo 2^64"
    },
    {
      "target_id": "FC-ADDER-BOUNDARY",
      "name": "zero, all-ones, and bit-63 boundaries",
      "weight": 1,
      "coverage_definition": "Exercise zero, 2^63, and 2^64-1 operand boundaries",
      "sampling_rule": "Sample each frozen boundary vector under the common transaction adapter",
      "oracle_definition": "Each sum/cout pair equals the 65-bit reference result"
    },
    {
      "target_id": "FC-ADDER-API-OBSERVE",
      "name": "public API observation path",
      "weight": 1,
      "coverage_definition": "Drive a/b/cin and observe sum/cout through the benchmark public API",
      "sampling_rule": "Use the common API adapter and sample after its documented step/settle operation",
      "oracle_definition": "API-observed sum/cout equals direct 65-bit reference arithmetic"
    }
  ],
