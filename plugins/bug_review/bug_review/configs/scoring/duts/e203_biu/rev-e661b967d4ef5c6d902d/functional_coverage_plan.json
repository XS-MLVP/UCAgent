  "targets": [
    {
      "target_id": "FC-BIU-RESET-IDLE",
      "name": "reset initialization and interface idle",
      "weight": 1,
      "coverage_definition": "Verify all ICB master and slave ports remain idle upon reset",
      "sampling_rule": "Sample valid/ready and cmd/rsp channels upon reset release",
      "oracle_definition": "No spurious requests or acknowledgments on any bus interface",
      "collection_status": "scoreable"
    },
    {
      "target_id": "FC-BIU-LSU-ACCESS",
      "name": "Load-Store Unit ICB request transaction",
      "weight": 1,
      "coverage_definition": "Drive LSU memory read/write requests through BIU to memory",
      "sampling_rule": "Sample LSU ICB cmd and rsp channels during transaction",
      "oracle_definition": "LSU requests correctly route to target address with proper write mask",
      "collection_status": "scoreable"
    },
    {
      "target_id": "FC-BIU-IFU-ACCESS",
      "name": "Instruction Fetch Unit ICB request transaction",
      "weight": 1,
      "coverage_definition": "Drive IFU instruction fetch requests through BIU",
      "sampling_rule": "Sample IFU ICB cmd and rsp channels during fetch",
      "oracle_definition": "IFU requests execute without protocol violation and return requested instruction",
      "collection_status": "scoreable"
    },
    {
      "target_id": "FC-BIU-ARBITRATION",
      "name": "LSU and IFU contention arbitration",
      "weight": 1,
      "coverage_definition": "Simultaneously assert LSU and IFU requests to observe priority arbitration",
      "sampling_rule": "Sample grant signals when both LSU and IFU cmd_valid are high",
      "oracle_definition": "Higher-priority port is serviced first without starving the secondary port",
      "collection_status": "scoreable"
    },
    {
      "target_id": "FC-BIU-ADDR-DECODE",
      "name": "address decoding and peripheral routing",
      "weight": 1,
      "coverage_definition": "Exercise address regions mapped to PPI, CLINT, PLIC, FIO and Main Memory",
      "sampling_rule": "Drive transactions across address boundary boundaries and sample chip-selects",
      "oracle_definition": "Requests route strictly to the designated target peripheral bus",
      "collection_status": "scoreable"
    },
    {
      "target_id": "FC-BIU-ERROR-RESPONSE",
      "name": "bus error and illegal address handling",
      "weight": 1,
      "coverage_definition": "Access unmapped or error-triggering address spaces to observe error response",
      "sampling_rule": "Sample rsp_err signal on transaction completion",
      "oracle_definition": "BIU sets rsp_err high and completes the ICB transaction cleanly",
      "collection_status": "scoreable"
    }
  ],
