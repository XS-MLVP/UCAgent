    {
      "target_id": "FC-TXFIFO-RESET",
      "name": "asynchronous reset and empty flag assertion",
      "weight": 1,
      "coverage_definition": "Assert reset and verify read/write pointers and status flags initialize",
      "sampling_rule": "Sample empty (high), full (low), and pointers immediately following reset",
      "oracle_definition": "FIFO is completely empty with no stale data or active flags",
      "collection_status": "scoreable"
    },
    {
      "target_id": "FC-TXFIFO-WRITE-FILL",
      "name": "write clock domain data push",
      "weight": 1,
      "coverage_definition": "Write data into FIFO until reaching programmed depth or full threshold",
      "sampling_rule": "Assert wr_en on write clock and sample data_in and full flag",
      "oracle_definition": "Data words are enqueued sequentially; empty flag deasserts",
      "collection_status": "scoreable"
    },
    {
      "target_id": "FC-TXFIFO-READ-POP",
      "name": "read clock domain data pop",
      "weight": 1,
      "coverage_definition": "Read data from FIFO across read clock domain and observe FIFO order",
      "sampling_rule": "Assert rd_en on read clock and sample data_out",
      "oracle_definition": "Output data matches first-in first-out sequence of written data",
      "collection_status": "scoreable"
    },
    {
      "target_id": "FC-TXFIFO-FULL-FLAG",
      "name": "FIFO full condition and write protection",
      "weight": 1,
      "coverage_definition": "Fill FIFO to capacity to assert full flag and block overflow",
      "sampling_rule": "Sample full flag and attempt additional write when full=1",
      "oracle_definition": "full asserts at exactly max depth and pointer does not advance on overflow",
      "collection_status": "scoreable"
    },
    {
      "target_id": "FC-TXFIFO-EMPTY-FLAG",
      "name": "FIFO empty condition and read protection",
      "weight": 1,
      "coverage_definition": "Drain FIFO completely to assert empty flag and block underflow",
      "sampling_rule": "Sample empty flag when last element is popped and attempt underflow read",
      "oracle_definition": "empty asserts immediately and read pointer does not advance on underflow",
      "collection_status": "scoreable"
    }
  ],
