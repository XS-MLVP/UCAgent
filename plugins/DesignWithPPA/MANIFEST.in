include ucagent-plugin.toml
include Makefile
recursive-include tests *.py
recursive-include tests/fixtures *.scala
recursive-include src/design_with_ppa/assets *
recursive-include src/design_with_ppa/workflows *.yaml
recursive-include src/design_with_ppa/Guide_Doc *.md
recursive-include src/design_with_ppa/templates *
