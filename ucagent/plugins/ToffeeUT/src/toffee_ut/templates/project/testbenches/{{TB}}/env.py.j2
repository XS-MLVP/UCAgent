# Set the confirmed clock pin for sequential DUTs; leave None only for clockless DUTs.
CLOCK_PIN = None


class DUTEnvironment:
    """Own drivers, monitors and checking; expose transaction methods to scenarios."""

    def __init__(self, dut):
        """Retain a fixture-owned native DUT; do not advance it during construction."""
        self._dut = dut
        self._backend = None
        self._execution = None

    async def __aenter__(self):
        """Start one simulation owner; register actual Driver/Monitor components here."""
        if CLOCK_PIN is not None:
            self._dut.InitClock(CLOCK_PIN)
            self._backend = XCommClockBackend(self._dut.GetXClock())
            self._execution = Execution(self._backend)
            try:
                await self._execution.__aenter__()
            except BaseException:
                self._backend.close()
                raise
        return self

    async def __aexit__(self, exc_type, exc, traceback):
        """Finish real completion obligations before releasing simulation ownership."""
        try:
            if self._execution is not None:
                await self._execution.__aexit__(exc_type, exc, traceback)
        finally:
            if self._backend is not None:
                self._backend.close()

